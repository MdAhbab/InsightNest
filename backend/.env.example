DB_URL=jdbc:mysql://localhost:3306/insightnest?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=dev-secret-change-me-please-use-32-bytes-minimum
BOOTSTRAP_SECRET=dev-bootstrap-secret
STORAGE_PATH=storage

# ── AI advisory agents (optional) ───────────────────────────────────────────
# Leave AGENT_LLM_ENABLED=false to run the four agents on the deterministic
# heuristic brain (no external services, works out of the box).
# Set it to true to narrate answers with an LLM. Providers are tried in the order
# listed; if one fails the next is used, and if all fail the heuristic answers — so
# the endpoints never hard-fail. Configure only the providers you want.
AGENT_LLM_ENABLED=false
AGENT_LLM_PROVIDERS=ollama,openai,gemini
AGENT_TIMEOUT_SECONDS=60

# Primary: local Ollama. Set OLLAMA_MODEL to a tag you have pulled (`ollama list`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Fallback: OpenAI (ChatGPT). Leave the key blank to disable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fallback: Google Gemini. Leave the key blank to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
